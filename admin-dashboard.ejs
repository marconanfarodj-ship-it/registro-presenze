<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard amministratore — Registro Presenze</title>
<%- include('partials/head-icons') %>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="wrap">
  <header class="glass">
    <div class="brand">
      <div class="logo-mark">📋</div>
      <div>
        <h1>Registro presenze — amministratore</h1>
        <p class="subtitle">Clicca su una casella per far cambiare stato: — → Presente → Assente → Ferie → Malattia</p>
      </div>
    </div>
    <div>
      <div class="month-nav">
        <a class="nav-btn" href="/admin?y=<%= prev.y %>&m=<%= prev.m %>">‹</a>
        <span class="label"><%= monthLabel %></span>
        <a class="nav-btn" href="/admin?y=<%= next.y %>&m=<%= next.m %>">›</a>
      </div>
      <p class="link-row" style="margin-top:6px;"><a href="/admin/logout">esci</a></p>
    </div>
  </header>

  <div class="toolbar glass">
    <% if (restoreError) { %>
      <div style="width:100%; background: rgba(230,90,60,0.18); border:1px solid var(--accent-a); color: var(--accent-a); padding:10px 14px; border-radius:10px; font-size:0.85rem;">
        Il file caricato non è un backup valido per questa versione dell'app (potrebbe essere di una versione precedente). Nessun dato è stato modificato.
      </div>
    <% } %>
    <div class="legend">
      <span><span class="swatch" style="background:var(--accent-p-bg); box-shadow: inset 0 0 0 1px var(--accent-p);"></span>Presente</span>
      <span><span class="swatch" style="background:var(--accent-a-bg); box-shadow: inset 0 0 0 1px var(--accent-a);"></span>Assente</span>
      <span><span class="swatch" style="background:var(--accent-f-bg); box-shadow: inset 0 0 0 1px var(--accent-f);"></span>Ferie</span>
      <span><span class="swatch" style="background:var(--accent-m-bg); box-shadow: inset 0 0 0 1px var(--accent-m);"></span>Malattia</span>
    </div>
    <div class="add-row">
      <a class="btn ghost" href="/admin/backup">⭳ Backup</a>
      <form class="inline" method="POST" action="/admin/restore?y=<%= y %>&m=<%= m0+1 %>" enctype="multipart/form-data" onsubmit="return confirm('Ripristinare questo backup sostituirà TUTTI i dati attuali (dipendenti e presenze). Continuare?');">
        <label class="btn ghost" style="cursor:pointer;">
          ⭱ Ripristina
          <input type="file" name="backupFile" accept="application/json,.json" style="display:none;" onchange="this.form.submit()">
        </label>
      </form>
      <form class="inline add-row" method="POST" action="/admin/employees?y=<%= y %>&m=<%= m0+1 %>">
        <input type="text" name="name" placeholder="Nome dipendente" required maxlength="60">
        <input type="email" name="email" placeholder="Email dipendente" required maxlength="120">
        <input type="number" name="rateWeek" placeholder="€ Lun–Ven" step="0.01" min="0" style="width:100px;">
        <input type="number" name="rateWeekend" placeholder="€ Sab/Dom" step="0.01" min="0" style="width:100px;">
        <button class="btn" type="submit">Aggiungi</button>
      </form>
    </div>
  </div>

  <div class="glass table-shell" id="tableShell">
    <% if (employees.length === 0) { %>
      <div class="empty-state"><p>Nessun dipendente ancora. Aggiungine uno per iniziare.</p></div>
    <% } else { %>
    <table>
      <thead>
        <tr>
          <th class="name-col">Dipendente / tariffe</th>
          <% headerDays.forEach(function(hd){ %>
            <th class="<%= hd.weekend ? 'weekend' : '' %>"><span class="dow"><%= hd.dow %></span><%= hd.day %></th>
          <% }) %>
          <th>P</th><th>A</th><th>F</th><th>M</th>
          <th style="border-left:1px solid var(--line);">Da pagare</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(r){ %>
        <tr data-emp="<%= r.emp.id %>">
          <td class="name-col">
            <div class="emp-name-row">
              <div style="flex:1;">
                <form method="POST" action="/admin/employees/<%= r.emp.id %>/update?y=<%= y %>&m=<%= m0+1 %>" style="display:flex; flex-direction:column; gap:3px;">
                  <input type="text" name="name" value="<%= r.emp.name %>" class="rate-input" style="width:100%; font-weight:600; font-size:0.82rem;" required>
                  <input type="email" name="email" value="<%= r.emp.email %>" class="rate-input" style="width:100%; font-size:0.68rem;" required>
                  <div class="rate-row">
                    <div class="rate-field">
                      <label>Lun–Ven €</label>
                      <input class="rate-input" type="number" name="rateWeek" step="0.01" min="0" value="<%= r.emp.rate_week %>">
                    </div>
                    <div class="rate-field">
                      <label>Sab/Dom €</label>
                      <input class="rate-input" type="number" name="rateWeekend" step="0.01" min="0" value="<%= r.emp.rate_weekend %>">
                    </div>
                    <button class="rate-save" type="submit" title="Salva">💾</button>
                  </div>
                </form>
              </div>
              <form class="inline" method="POST" action="/admin/employees/<%= r.emp.id %>/delete?y=<%= y %>&m=<%= m0+1 %>" onsubmit="return confirm('Rimuovere questo dipendente e tutte le sue presenze?');">
                <button class="del-btn" type="submit" title="Rimuovi">✕</button>
              </form>
            </div>
          </td>
          <% r.days.forEach(function(d){ %>
            <td class="<%= d.weekend ? 'weekend' : '' %>">
              <form class="inline" method="POST" action="/admin/attendance?y=<%= y %>&m=<%= m0+1 %>">
                <input type="hidden" name="employeeId" value="<%= r.emp.id %>">
                <input type="hidden" name="date" value="<%= y %>-<%= (m0+1).toString().padStart(2,'0') %>-<%= d.day.toString().padStart(2,'0') %>">
                <input type="hidden" name="current" value="<%= d.status %>">
                <input type="hidden" name="y" value="<%= y %>">
                <input type="hidden" name="m" value="<%= m0+1 %>">
                <button class="cell-btn <%= d.today ? 'today' : '' %>" data-status="<%= d.status %>" type="submit" title="<%= d.label %>"><%= d.status %></button>
              </form>
            </td>
          <% }) %>
          <td class="summary-col" data-count="P"><%= r.countP %></td>
          <td class="summary-col" data-count="A"><%= r.countA %></td>
          <td class="summary-col" data-count="F"><%= r.countF %></td>
          <td class="summary-col" data-count="M"><%= r.countM %></td>
          <td class="total-col" data-total>€ <%= r.total.toLocaleString('it-IT', {minimumFractionDigits:2, maximumFractionDigits:2}) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td class="name-col">Totale da pagare</td>
          <td colspan="<%= headerDays.length + 4 %>"></td>
          <td class="grand-total" id="grandTotal">€ <%= grandTotal.toLocaleString('it-IT', {minimumFractionDigits:2, maximumFractionDigits:2}) %></td>
        </tr>
      </tfoot>
    </table>
    <% } %>
  </div>

  <footer class="note glass">
    I dipendenti vedono solo il proprio calendario, senza tariffe né totali: accedono con la propria email da <a href="/login"><%= '/login' %></a>.
  </footer>
</div>
<script>
(function(){
  var shell = document.getElementById("tableShell");
  var KEY = "presenze-scroll:<%= y %>-<%= m0+1 %>";
  var euro = function(n){ return "€ " + Number(n).toLocaleString("it-IT",{minimumFractionDigits:2, maximumFractionDigits:2}); };

  // Ripristina la posizione dopo un salvataggio (tariffe, nuovo dipendente, ecc.)
  var saved = null;
  try { saved = JSON.parse(sessionStorage.getItem(KEY)); sessionStorage.removeItem(KEY); } catch(e){}
  if (shell && saved) {
    shell.scrollLeft = saved.l; shell.scrollTop = saved.t; window.scrollTo(0, saved.w);
  } else if (shell) {
    // Prima apertura: porta in vista il giorno di oggi
    var today = shell.querySelector(".cell-btn.today");
    if (today) {
      var nameCol = shell.querySelector("thead th.name-col");
      var td = today.closest("td");
      var offset = nameCol ? nameCol.offsetWidth : 0;
      shell.scrollLeft = Math.max(0, td.offsetLeft - offset - (shell.clientWidth - offset) / 2 + td.offsetWidth / 2);
    }
  }
  document.addEventListener("submit", function(){
    if (!shell) return;
    try { sessionStorage.setItem(KEY, JSON.stringify({ l: shell.scrollLeft, t: shell.scrollTop, w: window.scrollY })); } catch(e){}
  }, true);

  // Cambio stato della casella senza ricaricare la pagina
  document.querySelectorAll("form .cell-btn").forEach(function(btn){
    var form = btn.form;
    form.addEventListener("submit", function(ev){
      ev.preventDefault();
      ev.stopPropagation();
      if (btn.dataset.busy) return;
      btn.dataset.busy = "1";
      btn.style.opacity = "0.5";
      fetch(form.action, {
        method: "POST",
        headers: { "Accept": "application/json", "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form)).toString(),
        credentials: "same-origin"
      }).then(function(res){
        var ct = res.headers.get("Content-Type") || "";
        if (!ct.includes("application/json")) { location.href = "/admin/login"; throw new Error("sessione"); }
        return res.json();
      }).then(function(data){
        if (!data || !data.ok) throw new Error("errore");
        btn.dataset.status = data.status;
        btn.textContent = data.status;
        btn.title = data.label;
        form.querySelector('input[name="current"]').value = data.status;
        var tr = btn.closest("tr");
        ["P","A","F","M"].forEach(function(k){
          var c = tr.querySelector('[data-count="'+k+'"]'); if (c) c.textContent = data["count"+k];
        });
        var t = tr.querySelector("[data-total]"); if (t) t.textContent = euro(data.total);
        var g = document.getElementById("grandTotal"); if (g) g.textContent = euro(data.grandTotal);
      }).catch(function(err){
        if (err.message !== "sessione") alert("Non sono riuscito a salvare. Controlla la connessione e riprova.");
      }).finally(function(){
        delete btn.dataset.busy;
        btn.style.opacity = "";
      });
    });
  });
})();
</script>
</body>
</html>
